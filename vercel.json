{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/diagnostic-ia",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    },
    {
      "source": "/guide-automatisation",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    }
  ],
  "redirects": [{ "source": "/agents-vocaux", "destination": "/automatisation", "permanent": true }],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/404/index.html" }]
}
